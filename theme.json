					]
				},
				{
					"name": "System",
					"slug": "system",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"name": "Tiny",
					"slug": "x-small",
					"size": "12px"
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "14px"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "18px"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "24px",
					"fluid": {
						"min": "20px",
						"max": "24px"
					}
				},
				{
					"name": "X Large",
					"slug": "x-large",
					"size": "30px",
					"fluid": {
						"min": "24px",
						"max": "30px"
					}
				},
				{
					"name": "XX Large",
					"slug": "xx-large",
					"size": "48px",
					"fluid": {
						"min": "24px",
						"max": "48px"
					}
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "60px",
					"fluid": {
						"min": "30px",
						"max": "60px"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "20",
					"slug": "20",
					"size": "10px"
				},
				{
					"name": "30",
					"slug": "30",
					"size": "15px"
				},
				{
					"name": "40",
					"slug": "40",
					"size": "30px"
				},
				{
					"name": "50",
					"slug": "50",
					"size": "50px"
				},
				{
					"name": "60",
					"slug": "60",
					"size": "70px"
				},
				{
					"name": "70",
					"slug": "70",
					"size": "100px"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Search box",
					"slug": "search",
					"shadow": "0 5px 30px rgba(0, 0, 0, 0.15)"
				},
				{
					"name": "Card hover",
					"slug": "card",
					"shadow": "0 0 50px rgba(0, 0, 0, 0.1)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--copy)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--open-sans)",
			"fontSize": "var(--wp--preset--font-size--small)",
			"fontWeight": "600",
			"lineHeight": "2"
		},
		"spacing": {
			"blockGap": "16px",
			"padding": {
				"left": "15px",
				"right": "15px",
				"top": "0px",
				"bottom": "0px"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--open-sans)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "20px"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "16px"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-text)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "50px",
					"textTransform": "uppercase"
				},
				"border": {
					"radius": "0px",
					"width": "0px"
				},
				"spacing": {
					"padding": {
						"top": "0px",
						"bottom": "0px",
						"left": "30px",
						"right": "30px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--dark)",
						"text": "var(--wp--preset--color--overlay)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--dark)",
						"text": "var(--wp--preset--color--overlay)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--divider)"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "inherit"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--primary-text)"
							}
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--primary-text)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"typography": {
					"fontStyle": "italic"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--panel)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without banner",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-with-sidebar",
			"title": "Page with sidebar",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Journal sidebar",
			"area": "uncategorized"
		}
	]
}
